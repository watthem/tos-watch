# OTA repo clones (rebuildable). The Jev answer cache is tracked: fresh
# Jev answers differ from cached ones near the threshold, so a CI run
# without it re-scored all history and wrote 186 old alerts (2026-09-29).
/cache/*
!/cache/jev/
/datasets/cache/

# Python
__pycache__/
*.pyc

# Node / Cloudflare
node_modules/
.wrangler/
.dev.vars*
!.dev.vars.example

# Env / secrets
.env
*.env.local
!.env.example

# OS
.DS_Store

# Local scratch (Buttondown exports, logs)
/temp/
