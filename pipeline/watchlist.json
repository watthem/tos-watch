{
  "tracks": [
    {
      "id": "ai-assistants",
      "label": "AI assistants",
      "description": "Chat assistants and generative-AI product terms: what they do with your prompts, and how that feeds AI training."
    },
    {
      "id": "dating",
      "label": "Dating apps",
      "description": "Some of the most sensitive personal data people hand over voluntarily: photos, location, sexuality, health."
    },
    {
      "id": "typing",
      "label": "Things you type into",
      "description": "Writing assistants, keyboards, notes, translation, transcription, and email -- everywhere AI now reads what you type."
    },
    {
      "id": "dev-tools",
      "label": "Developer tools",
      "description": "Usage tracking, AI training on your code, and credit- or usage-based pricing terms at the platforms developers build on."
    },
    {
      "id": "consumer",
      "label": "Consumer apps",
      "description": "The broad social, video, and marketplace apps most people use every day."
    },
    {
      "id": "trading-finance",
      "label": "Trading and finance",
      "description": "Charting, futures brokers, banks and payment platforms: data use, fees, and what you may do with their data or scripts."
    }
  ],
